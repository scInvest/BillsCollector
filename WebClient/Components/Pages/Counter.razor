@page "/"
@using BlazorDatasheet.Core.Data
@using BlazorDatasheet
@using BlazorDatasheet.Core
@using BlazorDatasheet.Core.Data.Cells
@using BlazorDatasheet.Core.Formats
@using BlazorDatasheet.DataStructures.Store
@using BlazorDatasheet.Formula.Core
@using MudBlazor
@using WebClient.Components.UIComponents
@using WebClient.Components.UIComponents.DataPicker
@using WebClient.Components.UIComponents.Dialogs
@using WebClient.Components.UIComponents.SheetUI
@using WebClient.Components.UIComponents.TabbedBar
@using WebClient.ViewModels

@rendermode InteractiveServer

@using CostAnalizerApp
@inject CostAnalizerApplication CostAnalizer
@implements IRefreshableComponent
@layout WebClient.Components.Layout.EmptyLayout

<PageTitle>Counter</PageTitle>

<!-- Alert component registers with DialogService to show JS alerts -->
<AlertComponent />

<div class="counter-sections section2-hidden counter-page">
    <!-- sekcja 1-->
    <section class="counter-section section-1">
        <div class="counter-section-content">
            <DataPicker @ref="dataPicker" ViewModelCallBack="() => this.ViewModel.DataPickerViewModel">

            </DataPicker>
        </div>
    </section>
    <!-- sekcja koniec-->

    <!-- sekcja 2-->
    <section class="counter-section section-2">
        <div class="counter-section-content">
            @* <h1 style="@(((analiticBar != null && analiticBar.Tabs.Count > 0) || (dataBar != null && dataBar.Tabs.Count > 0)) ? "" : "display:none")">
                VIZUALIZACJE
            </h1> *@
        </div>
    </section>
    <!-- sekcja koniec-->

    <!-- sekcja 3-->
    <section class="counter-section section-3">
        <div class="counter-section-content">
            <div class="tabbed-row" style="@(((analiticBar != null && analiticBar.Tabs.Count > 0) || (dataBar != null && dataBar.Tabs.Count > 0)) ? "" : "display:none")">
                <div class="tabbed-panel" )">
                    <div class="panel-title">Analiza</div>
                    <TabbedBar OnSelectionChanged="OnSelectedIndexChanged"
                               BeforeDeleteCallback="(x) => this.ViewModel.UserInput_SheetDeleted(x)"
                               @ref="analiticBar"
                               AddTabCallback="UserInput_AddAnalyticViewClicked"></TabbedBar>
                </div>

                <div class="tabbed-panel">
                    <div class="panel-title">Dane</div>
                    <TabbedBar OnSelectionChanged="OnSelectedIndexDataChanged"
                               BeforeDeleteCallback="(x) => this.ViewModel.UserInput_SheetDeleted(x)"
                               @ref="dataBar"
                               AddTabCallback="UserInput_AddDataClicked"></TabbedBar>
                </div>
            </div>
        </div>
    </section>
    <!-- sekcja koniec-->

    <!-- Sekcja numer 4 -->
    <section class="counter-section section-4">
        <div class="counter-section-content">
            @if (SelectedSheet is null)
            {
                <div class="empty-message">
                    <h1>Dodaj dane by rozpocząć</h1>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(LastMenuAction))
            {
                <div class="empty-message">
                    <p>Last datasheet menu action: @LastMenuAction</p>
                </div>
            }

            @* Keep all components instantiated but hide those that are not the selected sheet. *@
            @foreach (var item in dataSheetComponents)
            {
                var key = item.Key;
                var isVisible = SelectedSheet == key;
                <div style="@($"height: 100%; display:{(isVisible ? "block" : "none")}")">
                    <DataSheetComponent @ref="AddDataSheetComponent" ID="@key" @key="key"></DataSheetComponent>
                </div>
            }

            @foreach (var item in dataSheetAnaliticalComponents)
            {
                var key = item.Key;
                var isVisible = SelectedSheet == key;
                <div style="@($"height: 100%; display:{(isVisible ? "block" : "none")}")">
                    <DataSheetComponent @ref="AddDataSheetComponent" ID="@key" @key="key"></DataSheetComponent>
                </div>
            }
        </div>
    </section>
    <!-- sekcja 4-->
</div>
@code {

    public DataSheetComponent AddDataSheetComponent
    {
        set
        {
            if (!dataSheetComponentInstances.ContainsKey(value.ID))
            {
                dataSheetComponentInstances.Add(value.ID, value);
                SheetAdded?.Invoke(value.ID, value);
            }
        }
    }
    public void Refresh()
    {
        this.StateHasChanged();
    }
    public event Action<string>? BeforeSheetAdded;
    public event Action<string, DataSheetComponent>? SheetAdded;

    Dictionary<string, DataSheetComponent> dataSheetComponentInstances = new();
    Dictionary<string, object> dataSheetComponents = new();
    Dictionary<string, object> dataSheetAnaliticalComponents = new();
    TabbedBar analiticBar = null!;
    TabbedBar dataBar = null!;

    private string? LastMenuAction;

    DataPicker dataPicker = null!;

    public MainViewModel ViewModel { get; set; }

    public string? SelectedSheet => analiticBar?.Selection?.Key ?? dataBar?.Selection?.Key;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ViewModel = new MainViewModel
        (
            () => this,
            () => this.dataPicker,
            () => CostAnalizer
        );
    }
    public enum SheetGroup
    {
        Analitical,
        Data
    }

    public SharedCode.Result<(string Title, string Key)?> AddSheet(SheetGroup sheetGroup, string title, string? id)
    {
        Dictionary<string, object> sheets = sheetGroup == SheetGroup.Analitical ? this.dataSheetAnaliticalComponents : this.dataSheetComponents;
        TabbedBar bar = sheetGroup == SheetGroup.Analitical ? this.analiticBar : this.dataBar;
        var item = AddItemToCollection(title, sheets, id);

        if (item == null)
        {
            throw new ArgumentNullException();
        }

        bar.AddTab(item.Value);

        return SharedCode.Result<(string Title, string Key)?>.Success(item);
    }

    /// <summary>
    /// Remove a sheet by its id. Removes entry from whichever collection contains it
    /// (data or analytic), removes any instantiated DataSheetComponent and removes
    /// the corresponding tab from the TabbedBar.
    /// </summary>
    /// <param name="id">Sheet id (key)</param>
    public void RemoveSheet(string id)
    {
        if (string.IsNullOrWhiteSpace(id))
            return;

        // Try remove from data sheets
        if (this.dataSheetComponents.ContainsKey(id))
        {
            this.dataSheetComponents.Remove(id);
            this.dataBar?.Remove(id);
            this.dataSheetComponentInstances.Remove(id);
            StateHasChanged();
            return;
        }

        // Try remove from analytic sheets
        if (this.dataSheetAnaliticalComponents.ContainsKey(id))
        {
            this.dataSheetAnaliticalComponents.Remove(id);
            this.analiticBar?.Remove(id);
            this.dataSheetComponentInstances.Remove(id);
            StateHasChanged();
            return;
        }
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
        }
        base.OnAfterRender(firstRender);
    }

    private void OnSelectedIndexChanged((int index, string key)? selection)
    {
        // when analytic selection changes, clear data selection
        this.dataBar.Select(null);
        this.StateHasChanged();
    }

    private void OnSelectedIndexDataChanged((int index, string key)? selection)
    {
        // when data selection changes, clear analytic selection
        this.analiticBar.Select(null);
        this.StateHasChanged();
    }

    private Task HandleMenuItemInvoked(string action)
    {
        LastMenuAction = action;
        StateHasChanged();
        return Task.CompletedTask;
    }

    // Shared helper that creates a new entry title/key, adds it to the provided collection and returns the tuple.
    private (string Title, string Key)? AddItemToCollection(string name, Dictionary<string, object> collection, string? id)
    {
        id = id ?? Guid.NewGuid().ToString();
        var rtn = (Title: name, Key: id);
        this.BeforeSheetAdded?.Invoke(rtn.Key);
        collection.Add(rtn.Key, rtn.Title);
        return rtn;
    }

    private (string Title, string Key)? UserInput_AddDataClicked(int index)
    {
        var rtn = AddItemToCollection("Data " + index, this.dataSheetComponents, null);
        this.ViewModel.UserInput_AddDataClicked();

        return rtn;
    }

    private (string, string)? UserInput_AddAnalyticViewClicked(int index)
    {
        var rtn = AddItemToCollection("Analiza " + index, this.dataSheetAnaliticalComponents, null);
        this.ViewModel.UserInput_AddAnalyticAdded();
        return rtn;
    }
}