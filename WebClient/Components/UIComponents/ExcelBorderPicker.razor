@code {

    public enum BorderOption
    {
        None,
        AllBorders,
        OutsideBorders,
        ThickOutsideBorders,
        BottomBorder,
        TopBorder,
        LeftBorder,
        RightBorder,
        NoBorder
    }

}
@inject SheetFocusManger SheetFocusManger

<div class="excel-border-picker">
    <button class="border-button compact" @onclick="ToggleDropdown">
        <span class="icon-wrapper">
            @((MarkupString)GetIcon(SelectedBorder))
        </span>
    </button>

    @if (IsOpen)
    {
        <div class="dropdown-panel">
            @foreach (var option in Enum.GetValues<BorderOption>())
            {
                <div class="dropdown-item"
                     @onclick="() => SelectBorder(option)">

                    <span class="item-icon">
                        @((MarkupString)GetIcon(option))
                    </span>

                    <span class="item-text">
                        @GetLabel(option)
                    </span>
                </div>
            }
        </div>
    }
</div>

