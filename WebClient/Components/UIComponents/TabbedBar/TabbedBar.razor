@using Microsoft.AspNetCore.Components
<div class="tabbed-bar">
    <div class="tabs">
        @for (int i = 0; i < tabs.Count; i++)
        {
            int index = i; // capture loop variable for lambda
             <button class="tab @(SelectedIndex.HasValue && i == SelectedIndex.Value ? "active" : "")" @onclick="() => Select(index)">@tabs[index]</button>
        }

        <button class="add-btn" title="Dodaj zakładkę" @onclick="AddTab">+</button>
        <button class="clear-btn" title="Brak" @onclick="ClearSelection">×</button>
    </div>

    @* Content rendering removed - will be handled externally *@
</div>

@code {
    private List<string> tabs = new();

    // Public list of render fragments (can be set by parent)
    [Parameter]
    public List<RenderFragment?> Contents { get; set; } = new();

    // Public selected index
    public int? SelectedIndex { get; private set; } = null;

    // Public accessor for the currently selected fragment
    public RenderFragment? SelectedContent => SelectedIndex.HasValue && SelectedIndex.Value >= 0 && SelectedIndex.Value < Contents.Count ? Contents[SelectedIndex.Value] : null;

    /// <summary>
    /// Optional callback invoked when a new tab is added. The int parameter is the new tab index.
    /// The callback should return a RenderFragment which will be rendered as the tab content.
    /// If not provided, a default content fragment is used.
    /// </summary>
    [Parameter]
    public Func<int, RenderFragment>? AddTabCallback { get; set; }

    /// <summary>
    /// Event invoked when selection changes. The argument is the new selected index (or null).
    /// </summary>
    [Parameter]
    public EventCallback<int?> OnSelectionChanged { get; set; }

    protected override void OnInitialized()
    {
        // start with two tabs
        tabs.Add("Tab 1");
        tabs.Add("Tab 2");

        // initialize contents with default fragments if none provided
        if (Contents.Count == 0)
        {
            Contents.Add(DefaultContentFragment(1));
            Contents.Add(DefaultContentFragment(2));
        }

        // leave selection empty by default
        SelectedIndex = null;
    }

    public void AddTab()
    {
        var newIndex = tabs.Count;
        tabs.Add($"Tab {newIndex + 1}");

        RenderFragment? fragment = null;
        if (AddTabCallback is not null)
        {
            try
            {
                fragment = AddTabCallback(newIndex);
            }
            catch
            {
                // swallow callback exceptions and fall back to default content
                fragment = null;
            }
        }

        Contents.Add(fragment ?? DefaultContentFragment(newIndex + 1));
        SelectedIndex = tabs.Count - 1;
        _ = OnSelectionChanged.InvokeAsync(SelectedIndex);
        StateHasChanged();
    }

    private void Select(int index)
    {
        if (index >= 0 && index < tabs.Count)
        {
            SelectedIndex = index;
            _ = OnSelectionChanged.InvokeAsync(SelectedIndex);
        }
        this.StateHasChanged();
    }

    private void ClearSelection()
    {
        SelectedIndex = null;
        _ = OnSelectionChanged.InvokeAsync(SelectedIndex);
        StateHasChanged();
    }

    private RenderFragment DefaultContentFragment(int number) => builder =>
    {
        builder.OpenElement(0, "p");
        builder.AddContent(1, $"Content {number}");
        builder.CloseElement();
    };
}
