@using Microsoft.AspNetCore.Components
<div class="tabbed-bar">
    <div class="tabs">
        @for (int i = 0; i < tabs.Count; i++)
        {
            int index = i; // capture loop variable for lambda
             <button class="tab @(selected.HasValue && i == selected.Value ? "active" : "")" @onclick="() => Select(index)">@tabs[index]</button>
        }

        <button class="add-btn" title="Dodaj zakładkę" @onclick="AddTab">+</button>
        <button class="clear-btn" title="Brak" @onclick="ClearSelection">×</button>
    </div>

    <div class="tab-content" style="display:@(selected.HasValue ? "block" : "none")">
        <div class="content">
            @if (selected.HasValue)
            {
                var idx = selected.Value;
                if (contents.Count > idx && contents[idx] is not null)
                {
                    @contents[idx]
                }
                else
                {
                    <p>Content @(idx + 1)</p>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<string> tabs = new();
    private List<RenderFragment?> contents = new();
    private int? selected = null;

    /// <summary>
    /// Optional callback invoked when a new tab is added. The int parameter is the new tab index.
    /// The callback should return a RenderFragment which will be rendered as the tab content.
    /// If not provided, a default content fragment is used.
    /// </summary>
    [Parameter]
    public Func<int, RenderFragment>? AddTabCallback { get; set; }

    protected override void OnInitialized()
    {
        // start with two tabs
        tabs.Add("Tab 1");
        tabs.Add("Tab 2");

        contents.Add(DefaultContentFragment(1));
        contents.Add(DefaultContentFragment(2));

        // leave selection empty by default
        selected = null;
    }

    public void AddTab()
    {
        var newIndex = tabs.Count;
        tabs.Add($"Tab {newIndex + 1}");

        RenderFragment? fragment = null;
        if (AddTabCallback is not null)
        {
            try
            {
                fragment = AddTabCallback(newIndex);
            }
            catch
            {
                // swallow callback exceptions and fall back to default content
                fragment = null;
            }
        }

        contents.Add(fragment ?? DefaultContentFragment(newIndex + 1));
        selected = tabs.Count - 1;
        StateHasChanged();
    }

    private void Select(int index)
    {
        if (index >= 0 && index < tabs.Count)
        {
            selected = index;
        }
        this.StateHasChanged();
    }

    private void ClearSelection()
    {
        selected = null;
        StateHasChanged();
    }

    private RenderFragment DefaultContentFragment(int number) => builder =>
    {
        builder.OpenElement(0, "p");
        builder.AddContent(1, $"Content {number}");
        builder.CloseElement();
    };
}
