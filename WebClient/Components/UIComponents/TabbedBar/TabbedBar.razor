@using Microsoft.AspNetCore.Components
<div class="tabbed-bar">
    <div class="tabs">
        @for (int i = 0; i < tabs.Count; i++)
        {
            int index = i; // capture loop variable for lambda
                           <button class="tab @(SelectedIndex.HasValue && i == SelectedIndex.Value ? "active" : "")" @onclick="() => Select(index, true)">@tabs[index].Title</button>
        }

        <button class="add-btn" title="Dodaj zakładkę" @onclick="AddTab">+</button>
    </div>

    @* Content is handled outside; this component only manages tab names and selection index *@
</div>

@code {
    private List<(string Title, string Key)> tabs = new();

    // Public selected index
    public int? SelectedIndex { get; private set; } = null;

    public (int Index, string Title, string Key)? Selection
    {
        get
        {
            if (SelectedIndex.HasValue)
            {
                var data = tabs[SelectedIndex.Value];
                return (SelectedIndex.Value, data.Title, data.Key);
            }
            else
            {
                return null;
            }
        }
    }
    public IReadOnlyList<(string Title, string Key)> Tabs => tabs;

    /// <summary>
    /// Callback invoked when the user requests adding a new tab. The int parameter is the new tab index.
    /// The callback should return the name for the new tab. Returning null cancels the operation.
    /// </summary>
    [Parameter]
    public Func<int, (string Title, string Key)?> AddTabCallback { get; set; } = null!;

    /// <summary>
    /// Event invoked when selection changes. The argument is the new selected index (or null).
    /// </summary>
    [Parameter]
    public EventCallback<(int Index, string Key)?> OnSelectionChanged { get; set; }

    protected override void OnInitialized()
    {
        SelectedIndex = null;
    }
    private void AddTab()
    {
        AddTab(null);
    }

    public void AddTab((string title, string key)? input)
    {
        if (AddTabCallback is null)
        {
            throw new InvalidOperationException("AddTabCallback must be provided to add tabs.");
        }

        var newIndex = tabs.Count;

        if (input == null)
        {
            input = AddTabCallback(newIndex);
        }

        // callback can cancel by returning null
        if (input == null)
        {
            return;
        }

        tabs.Add(input.Value);

        // select newly added tab
        SelectedIndex = tabs.Count - 1;
        var data = tabs[SelectedIndex.Value];
        _ = OnSelectionChanged.InvokeAsync((tabs.Count - 1, data.Key));

        StateHasChanged();
    }

    public void Select(int? index)
    {
        Select(index, false);
    }

    private void Select(int? index, bool @event)
    {
        if (index == null || (index >= 0 && index < tabs.Count))
        {
            SelectedIndex = index;
            if (@event)
            {
                var data = index.HasValue ? (index.Value, tabs[index.Value].Key) : default;
                _ = OnSelectionChanged.InvokeAsync(data);
            }
        }
        this.StateHasChanged();
    }
}
