@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using WebClient.Components.UIServices
@using SharedCode
@inject DialogService DialogService
@inject SheetFocusMangerService FocusManager;
@implements IFocusableObject;

<div class="tabbed-bar" @onclick:stopPropagation="false" @onclick="() => { if (contextMenuVisible) HideContextMenu(); }">
    <div class="tabs">
        @for (int i = 0; i < tabs.Count; i++)
        {
            int index = i; // capture loop variable for lambda
                           <button class="tab @(SelectedIndex.HasValue && i == SelectedIndex.Value ? "active" : "")"
                                   draggable="true"
                                   @ondragstart="() => { TriggerFocus(); OnDragStart(index); }"
                                   @ondragover:preventDefault="true"
                                   @ondrop:preventDefault="true"
                                   @ondragover="() => { TriggerFocus(); OnDragOver(); }"
                                   @ondrop="() => { TriggerFocus(); OnDrop(index); }"
                                   @onclick="() => { TriggerFocus(); Select(index, true); }"
                                   @oncontextmenu:preventDefault="true"
                                   @oncontextmenu="(e) => { TriggerFocus(); ShowContextMenu(e, index); }">
                               @tabs[index].Title
                           </button>
        }

        <button class="add-btn" title="Dodaj zakładkę" @onclick="() => { TriggerFocus(); AddTab(); }">+</button>
    </div>

    @if (contextMenuVisible)
    {
        <div class="tab-context-menu" style="position:fixed; left:@(contextMenuLeft)px; top:@(contextMenuTop)px; z-index:1000;">
            <button class="context-menu-item" @onclick="() => { TriggerFocus(); Rename(); HideContextMenu(); }">
                <span>✏️</span> Rename
            </button>
            <button class="context-menu-item context-menu-item-danger" @onclick="() => { TriggerFocus(); Delete(); HideContextMenu(); }">
                <span>🗑️</span> Delete
            </button>
        </div>
    }

    @* Content is handled outside; this component only manages tab names and selection index *@
</div>

@code {
    private List<(string Title, string Key)> tabs = new();

    // Public selected index
    public int? SelectedIndex { get; private set; } = null;

    // IFocusableObject implementation
    public event EventHandler? Focus;

    public void RemoveFocus()
    {
        HideContextMenu();
        StateHasChanged();
    }

    public void TriggerFocus()
    {
        Focus?.Invoke(this, EventArgs.Empty);
    }

    public (int Index, string Title, string Key)? Selection
    {
        get
        {
            if (SelectedIndex.HasValue)
            {
                var data = tabs[SelectedIndex.Value];
                return (SelectedIndex.Value, data.Title, data.Key);
            }
            else
            {
                return null;
            }
        }
    }
    public IReadOnlyList<(string Title, string Key)> Tabs => tabs;

    /// <summary>
    /// Callback invoked when the user requests adding a new tab. The int parameter is the new tab index.
    /// The callback should return the name for the new tab. Returning null cancels the operation.
    /// </summary>
    [Parameter]
    public Func<int, (string Title, string Key)?> AddTabCallback { get; set; } = null!;

    /// <summary>
    /// Event invoked when selection changes. The argument is the new selected index (or null).
    /// </summary>
    [Parameter]
    public EventCallback<(int Index, string Key)?> OnSelectionChanged { get; set; }

    /// <summary>
    /// Event invoked when the order of tabs changed. The tuple contains (fromIndex, toIndex).
    /// </summary>
    [Parameter]
    public EventCallback<(int From, int To)> OnOrderChanged { get; set; }

    protected override void OnInitialized()
    {
        SelectedIndex = null;
        FocusManager.Register(this);
    }
    private void AddTab()
    {
        AddTab(null);
    }

    // Drag & drop state
    private int? dragSourceIndex = null;

    private void OnDragStart(int index)
    {
        // store source index only; avoiding DataTransfer.SetData because it's not necessary here
        dragSourceIndex = index;
    }

    private void OnDragOver()
    {
        // No-op: preventDefault is applied via Blazor event modifier in markup.
    }

    private void OnDrop(int targetIndex)
    {
        if (!dragSourceIndex.HasValue)
            return;

        var from = dragSourceIndex.Value;
        var to = targetIndex;

        // normalize insertion index after removal
        if (from == to)
        {
            dragSourceIndex = null;
            return;
        }

        var item = tabs[from];
        tabs.RemoveAt(from);

        var insertIndex = to;
        if (from < to)
        {
            // after removal the target shifts left by one
            insertIndex = to - 1;
        }

        if (insertIndex < 0)
            insertIndex = 0;
        if (insertIndex > tabs.Count)
            insertIndex = tabs.Count;

        tabs.Insert(insertIndex, item);

        // adjust selection index to keep the same logical selection
        if (SelectedIndex.HasValue)
        {
            var sel = SelectedIndex.Value;
            if (sel == from)
            {
                SelectedIndex = insertIndex;
            }
            else if (from < insertIndex)
            {
                // moved right: elements between from+1..insertIndex shift left
                if (sel > from && sel <= insertIndex)
                    SelectedIndex = sel - 1;
            }
            else // from > insertIndex
            {
                // moved left: elements between insertIndex..from-1 shift right
                if (sel >= insertIndex && sel < from)
                    SelectedIndex = sel + 1;
            }
        }

        // notify about order change (report original from and final index)
        _ = OnOrderChanged.InvokeAsync((from, insertIndex));

        // notify selection changed with current selection
        if (SelectedIndex.HasValue)
        {
            var data = tabs[SelectedIndex.Value];
            _ = OnSelectionChanged.InvokeAsync((SelectedIndex.Value, data.Key));
        }
        else
        {
            _ = OnSelectionChanged.InvokeAsync(default((int, string)?));
        }

        dragSourceIndex = null;
        StateHasChanged();
    }

    public void AddTab((string title, string key)? input)
    {
        if (AddTabCallback is null)
        {
            throw new InvalidOperationException("AddTabCallback must be provided to add tabs.");
        }

        var newIndex = tabs.Count;

        if (input == null)
        {
            input = AddTabCallback(newIndex);
        }

        // callback can cancel by returning null
        if (input == null)
        {
            return;
        }

        tabs.Add(input.Value);

        // select newly added tab
        SelectedIndex = tabs.Count - 1;
        var data = tabs[SelectedIndex.Value];
        _ = OnSelectionChanged.InvokeAsync((tabs.Count - 1, data.Key));

        StateHasChanged();
    }

    public void Select(int? index)
    {
        Select(index, false);
    }

    private void Select(int? index, bool @event)
    {
        if (index == null || (index >= 0 && index < tabs.Count))
        {
            SelectedIndex = index;
            if (@event)
            {
                var data = index.HasValue ? (index.Value, tabs[index.Value].Key) : default;
                _ = OnSelectionChanged.InvokeAsync(data);
            }
        }
        this.StateHasChanged();
    }

    /// <summary>
    /// Remove a tab by its key. If the removed tab was selected, selection is cleared
    /// and OnSelectionChanged is invoked with null. If a tab before the current selection
    /// is removed, the SelectedIndex is adjusted accordingly.
    /// </summary>
    /// <param name="key">Tab key to remove</param>
    public void Remove(string key)
    {
        if (string.IsNullOrEmpty(key))
            return;

        var index = tabs.FindIndex(t => t.Key == key);
        if (index < 0)
            return;

        // remove the tab
        tabs.RemoveAt(index);

        if (SelectedIndex.HasValue)
        {
            if (SelectedIndex.Value == index)
            {
                // removed currently selected tab -> clear selection
                SelectedIndex = null;
                _ = OnSelectionChanged.InvokeAsync(default((int, string)?));
            }
            else if (SelectedIndex.Value > index)
            {
                // shift selection left by one to keep pointing to same logical tab
                SelectedIndex = SelectedIndex.Value - 1;
                var data = tabs[SelectedIndex.Value];
                _ = OnSelectionChanged.InvokeAsync((SelectedIndex.Value, data.Key));
            }
        }

        StateHasChanged();
    }

    // Context menu state
    private bool contextMenuVisible = false;
    private int contextMenuLeft = 0;
    private int contextMenuTop = 0;
    private int? contextMenuTabIndex = null;

    private void ShowContextMenu(MouseEventArgs e, int index)
    {
        contextMenuTabIndex = index;
        contextMenuLeft = (int)e.ClientX;
        contextMenuTop = (int)e.ClientY;
        contextMenuVisible = true;
        TriggerFocus();
        StateHasChanged();
    }

    private void HideContextMenu()
    {
        contextMenuVisible = false;
        contextMenuTabIndex = null;
        StateHasChanged();
    }

    private async void Rename()
    {
        if (contextMenuTabIndex.HasValue && contextMenuTabIndex.Value >= 0 && contextMenuTabIndex.Value < tabs.Count)
        {
            var index = contextMenuTabIndex.Value;
            var currentTitle = tabs[index].Title;
            var newTitle = await DialogService.ShowTextInput(currentTitle, "Rename Tab", "Wpisz nowa nazwe dla '" + currentTitle + "'", ValidateTabName);

            if (newTitle != null && !string.IsNullOrWhiteSpace(newTitle))
            {
                var tabItem = tabs[index];
                tabs[index] = (newTitle, tabItem.Key);
                StateHasChanged();
            }
        }
    }

    private Result ValidateTabName(string name)
    {
        return Result.Failure("Nazwa nie może być pusta");

        if (string.IsNullOrWhiteSpace(name))
        {
            return Result.Failure("Nazwa nie może być pusta");
        }

        if (name.Contains('\n') || name.Contains('\r'))
        {
            return Result.Failure("Nazwa nie może zawierać nowych linii");
        }

        if (name.Length > 128)
        {
            return Result.Failure("Nazwa nie może być dłuższa niż 128 znaków");
        }

        return Result.Success();
    }

    private void Delete()
    {
        if (contextMenuTabIndex.HasValue && contextMenuTabIndex.Value >= 0 && contextMenuTabIndex.Value < tabs.Count)
        {
            var key = tabs[contextMenuTabIndex.Value].Key;
            Remove(key);
        }
    }
}
