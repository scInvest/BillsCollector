@using Microsoft.JSInterop
@using System.Net
@inject UIServices.DialogService DialogService
@inject IJSRuntime JS
@implements IDisposable

@code {
    private Func<string, string?, Task>? _handler;

    protected override void OnInitialized()
    {
        _handler = async (text, title) =>
        {
            if (string.IsNullOrEmpty(title))
            {
                await JS.InvokeVoidAsync("alert", text).AsTask();
            }
            else
            {
                // Simple way to show a titled window: open a small popup with title and message.
                // Note: browser popup blockers may block this; for production consider a custom modal.
                var html = $"<html><head><title>{WebUtility.HtmlEncode(title)}</title></head><body><pre>{WebUtility.HtmlEncode(text)}</pre></body></html>";
                var dataUrl = "data:text/html;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(html));
                await JS.InvokeVoidAsync("open", dataUrl, "_blank", "noopener,noreferrer").AsTask();
            }
        };

        DialogService.RegisterAlertHandler(_handler);
    }

    public void Dispose()
    {
        DialogService.UnregisterAlertHandler();
    }
}
