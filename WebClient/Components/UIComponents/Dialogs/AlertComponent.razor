@using Microsoft.JSInterop
@using System.Net
@inject UIServices.DialogService DialogService
@inject IJSRuntime JS
@implements IDisposable
@implements UIServices.IAlertComponent

@code {
    protected override void OnInitialized()
    {
        DialogService.RegisterAlertComponent(this);
    }

    public async Task ShowAlert(string text)
    {
        await JS.InvokeVoidAsync("alert", text).AsTask();
    }

    public async Task ShowAlert(string text, string? title)
    {
        if (string.IsNullOrEmpty(title))
        {
            await ShowAlert(text);
            return;
        }

        var html = $"<html><head><title>{WebUtility.HtmlEncode(title)}</title></head><body><pre>{WebUtility.HtmlEncode(text)}</pre></body></html>";
        var dataUrl = "data:text/html;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(html));
        await JS.InvokeVoidAsync("open", dataUrl, "_blank", "noopener,noreferrer").AsTask();
    }

    public void Dispose()
    {
        DialogService.UnregisterAlertComponent();
    }
}
