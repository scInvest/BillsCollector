@using Microsoft.AspNetCore.Components
@using WebClient.Components.UIServices
@using SharedCode
@implements ITextInputComponent
@implements IDisposable

<div class="timodal-backdrop" style="@(Visible ? "display:block" : "display:none")">
    <div class="timodal">
        <div class="timodal-header">
            <div class="timodal-title">@Title</div>
            <button class="timodal-close" @onclick="OnCloseClicked" aria-label="Close">✕</button>
        </div>
        <div class="timodal-body">
            @if (!string.IsNullOrEmpty(HintText))
            {
                <div class="timodal-hint">@HintText</div>
            }
            @if (!string.IsNullOrEmpty(ValidationError))
            {
                <div class="timodal-error">@ValidationError</div>
            }
            <textarea class="timodal-textarea@(!string.IsNullOrEmpty(ValidationError) ? " error" : "")" @ref="TextareaElement" @bind="InputText" placeholder="Wpisz tekst..."></textarea>
        </div>
        <div class="timodal-footer">
            <button class="timodal-btn timodal-btn-secondary" @onclick="OnCancelClicked">Anuluj</button>
            <button class="timodal-btn timodal-btn-primary" @onclick="OnOkClicked">OK</button>
        </div>
    </div>
</div>

@code {
    [Inject]
    public DialogService DialogService { get; set; } = null!;

    [Inject]
    public IJSRuntime JSRuntime { get; set; } = null!;

    // Parameter to control initial visibility; component is initialized hidden by default
    public bool Visible { get; set; } = false;

    public string Title { get; set; } = "Wpisz tekst";

    // Current input value
    public string InputText { get; set; } = string.Empty;

    // Hint text displayed in the modal
    public string HintText { get; set; } = string.Empty;

    // Validation error message
    public string? ValidationError { get; set; } = null;

    private TaskCompletionSource<string?>? _tcs;
    private ElementReference TextareaElement;
    private Func<string, Result>? _validationFunc;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        DialogService.RegisterTextInputComponent(this);
    }

    public void Dispose()
    {
        DialogService.UnregisterTextInputComponent();
    }

    // Show the modal (call from parent via DialogService.ShowTextInput)
    public async Task<string?> ShowAsync(string initialText = "", string? title = null, string hintText = "", Func<string, Result>? validation = null)
    {
        InputText = initialText ?? string.Empty;
        Title = title ?? "Wpisz tekst";
        HintText = hintText ?? string.Empty;
        ValidationError = null;
        _validationFunc = validation;
        Visible = true;
        _tcs = new TaskCompletionSource<string?>();
        StateHasChanged();

        // Allow the DOM to update, then focus and select text
        await Task.Delay(50);
        await TextareaElement.FocusAsync();
        await JSRuntime.InvokeVoidAsync("eval", "document.querySelector('.timodal-textarea').select()");

        return await _tcs.Task;
    }

    // Hide the modal
    public void Hide()
    {
        Visible = false;
        StateHasChanged();
    }

    private async Task OnOkClicked()
    {
        // If validation function is provided, validate the input
        if (_validationFunc != null)
        {
            var validationResult = _validationFunc(InputText);
            if (!validationResult.IsSuccess)
            {
                ValidationError = validationResult.Error;
                StateHasChanged();
                return;
            }
        }

        // Validation passed, complete the task
        var tcs = _tcs;
        if (tcs != null && !tcs.Task.IsCompleted)
        {
            tcs.SetResult(InputText);
        }
        Hide();
        await Task.CompletedTask;
    }

    private async Task OnCancelClicked()
    {
        var tcs = _tcs;
        if (tcs != null && !tcs.Task.IsCompleted)
        {
            tcs.SetResult(null);
        }
        Hide();
        await Task.CompletedTask;
    }

    private Task OnCloseClicked()
    {
        return OnCancelClicked();
    }
}
