@using Microsoft.AspNetCore.Components
@using WebClient.Components.UIServices
@implements ITextInputComponent
@implements IDisposable

<div class="timodal-backdrop" style="@(Visible ? "display:block" : "display:none")">
    <div class="timodal">
        <div class="timodal-header">
            <div class="timodal-title">@Title</div>
            <button class="timodal-close" @onclick="OnCloseClicked" aria-label="Close">✕</button>
        </div>
        <div class="timodal-body">
            <textarea class="timodal-textarea" @bind="InputText" placeholder="Wpisz tekst..."></textarea>
        </div>
        <div class="timodal-footer">
            <button class="timodal-btn timodal-btn-secondary" @onclick="OnCancelClicked">Anuluj</button>
            <button class="timodal-btn timodal-btn-primary" @onclick="OnOkClicked">OK</button>
        </div>
    </div>
</div>

@code {
    [Inject]
    public DialogService DialogService { get; set; } = null!;

    // Parameter to control initial visibility; component is initialized hidden by default
    public bool Visible { get; set; } = false;

    public string Title { get; set; } = "Wpisz tekst";

    // Current input value
    public string InputText { get; set; } = string.Empty;

    private TaskCompletionSource<string?>? _tcs;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        DialogService.RegisterTextInputComponent(this);
    }

    public void Dispose()
    {
        DialogService.UnregisterTextInputComponent();
    }

    // Show the modal (call from parent via DialogService.ShowTextInput)
    public Task<string?> ShowAsync(string initialText = "", string? title = null)
    {
        InputText = initialText ?? string.Empty;
        Title = title ?? "Wpisz tekst";
        Visible = true;
        _tcs = new TaskCompletionSource<string?>();
        StateHasChanged();
        return _tcs.Task;
    }

    // Hide the modal
    public void Hide()
    {
        Visible = false;
        StateHasChanged();
    }

    private async Task OnOkClicked()
    {
        var tcs = _tcs;
        if (tcs != null && !tcs.Task.IsCompleted)
        {
            tcs.SetResult(InputText);
        }
        Hide();
        await Task.CompletedTask;
    }

    private async Task OnCancelClicked()
    {
        var tcs = _tcs;
        if (tcs != null && !tcs.Task.IsCompleted)
        {
            tcs.SetResult(null);
        }
        Hide();
        await Task.CompletedTask;
    }

    private Task OnCloseClicked()
    {
        return OnCancelClicked();
    }
}
