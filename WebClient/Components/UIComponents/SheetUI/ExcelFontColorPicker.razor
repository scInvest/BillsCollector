@using WebClient.Components.UIServices


@inject SheetFocusMangerService SheetFocusManger

<div class="excel-color-picker">

    <button class="color-button compact"
            @onclick="ToggleDropdown">
        @MainIcon.Invoke(this.SelectedColor)
    </button>

    @if (IsOpen)
    {
        <div class="color-dropdown">
            @foreach (var color in Colors)
            {
                <div class="color-item"
                     @onclick="() => SelectColor(color.Color)">

                    <div class="font-preview">
                        <span class="preview-letter"
                              style="color:@color.Color">
                        </span>
                        <div class="preview-bar"
                             style="background-color:@color.Color">
                        </div>
                    </div>
                    <span class="preview-letter"
                          style="color:@color.Color">
                        @color.Name
                    </span>
                </div>
            }
        </div>
    }
</div>
