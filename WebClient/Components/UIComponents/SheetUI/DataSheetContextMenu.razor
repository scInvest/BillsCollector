@using BlazorDatasheet.Core.Data
@using BlazorDatasheet.Menu
@using BlazorDatasheet.Services
@inject IMenuService MenuService
@inherits SheetMenuItem
    
<div class="sheet-context-menu">
    <button type="button"
            class="sheet-context-menu__item"
            @onclick="HandleRename">
        <span class="sheet-context-menu__icon" aria-hidden="true">✎</span>
        <span>Rename</span>
    </button>
</div>

@code {
    [Parameter]
    public Sheet? CurrentSheet { get; set; }

    private async Task HandleRename()
    {

        var s = CurrentSheet.Selection;
        this.CurrentSheet.Selection.Activate(0, 0);
        await MenuService.CloseMenu(this.MenuId, closeParent: true);
       
    }
}
