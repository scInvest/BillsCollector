@using BlazorDatasheet.Core.Data
@using BlazorDatasheet.Core.Formats
@using BlazorDatasheet.Core.Interfaces
@using BlazorDatasheet.DataStructures.Geometry
@using WebClient.Components.UIComponents.DataPicker
@using WebClient.Components.UIServices

@inject SheetFocusMangerService SheetFocusManger



<div class="ribbon">
<ExcelFontColorPicker @ref="colorPickerFont" Context="selectedColor" SelectedColorChanged="HandleForeGroundColorChange">
    <MainIcon>
        <div class="font-icon-wrapper">
            <span class="font-letter"
                  style="color:@selectedColor">
                A
            </span>
        </div>
    </MainIcon>
</ExcelFontColorPicker>
<ExcelFontColorPicker 
    @ref="colorPickerFill" 
    Context="selectedColor"
    SelectedColorChanged="HandleColorChanged">
    <MainIcon>
        <div class="fill-icon-wrapper">
            <div class="fill-icon"
                 style="background-color:@selectedColor">
            </div>

            <div class="color-bar"
                 style="background-color:@selectedColor">
            </div>
        </div>
    </MainIcon>
</ExcelFontColorPicker>
<ExcelBorderPicker @ref="borderPicker" SelectedBorderChanged="HandleBorderChanged"></ExcelBorderPicker>
</div>
<div>
<Datasheet @ref="datasheet"
           Sheet="sheet" />
</div>
@code {


}
