@using WebClient.Components.UIComponents.Dialogs
<div><TextInputModal @ref="Dialog"></TextInputModal>
    <!-- Enable Biedronka theme by default -->
    <div class="data-picker biedronka">
        <label class="data-picker-btn" role="button">
            <InputFile OnChange="HandleFileSelected" hidden multiple />
            <svg class="upload-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M19 15v4a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <polyline points="7 10 12 5 17 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <line x1="12" y1="5" x2="12" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="label-text">Biedronka</span>
        </label>
    </div>

    <!-- mBank themed picker: striped background (red, orange, burgundy, green) with white 'mbank' text -->
    <div class="data-picker mbank" style="display:inline-block; margin-left:12px">
        <label class="data-picker-btn" role="button">
            <InputFile OnChange="HandleFileSelected" hidden multiple />
            <svg class="upload-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M19 15v4a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <polyline points="7 10 12 5 17 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <line x1="12" y1="5" x2="12" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="label-text">mBank</span>
        </label>
    </div>

    <!-- Allegro themed picker: white background, orange text and border -->
    <div class="data-picker allegro" style="display:inline-block; margin-left:12px">
        <label class="data-picker-btn" role="button">
            <InputFile OnChange="HandleFileSelected" hidden multiple />
            <svg class="upload-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M19 15v4a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <polyline points="7 10 12 5 17 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <line x1="12" y1="5" x2="12" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="label-text">Allegro</span>
        </label>
    </div>

    <!-- Kaufland themed picker: white background, red border and text -->
    <div class="data-picker kaufland" style="display:inline-block; margin-left:12px">
        <label class="data-picker-btn" role="button">
            <InputFile OnChange="HandleFileSelected" hidden multiple />
            <svg class="upload-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M19 15v4a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <polyline points="7 10 12 5 17 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <line x1="12" y1="5" x2="12" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="label-text">Kaufland</span>
        </label>
    </div>

    <!-- Custom pale-green CSV picker -->
    <div class="data-picker csv-custom" style="display:inline-block; margin-left:12px">
        <label class="data-picker-btn" role="button">
            <InputFile OnChange="HandleFileSelected" hidden multiple />
            <svg class="upload-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M19 15v4a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <polyline points="7 10 12 5 17 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <line x1="12" y1="5" x2="12" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="label-text">Custom</span>
        </label>
    </div>

    <!-- Żabka themed picker: dark green background, light flashy green border and text -->
    <div class="data-picker zabka" style="display:inline-block; margin-left:12px">
        <label class="data-picker-btn" role="button">
            <InputFile OnChange="HandleFileSelected" hidden multiple />
            <svg class="upload-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M19 15v4a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <polyline points="7 10 12 5 17 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <line x1="12" y1="5" x2="12" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="label-text">
                ż<span class="underline">ab</span>ka
            </span>
        </label>
    </div>
</div>