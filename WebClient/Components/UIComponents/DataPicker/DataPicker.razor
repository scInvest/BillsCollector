            <polyline points="7 10 12 5 17 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            <line x1="12" y1="5" x2="12" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="label-text">mBank CSV</span>
    </label>
</div>

<!-- Allegro themed picker: white background, orange text and border -->
