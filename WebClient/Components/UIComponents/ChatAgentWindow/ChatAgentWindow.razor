<div class="agent-chat-window">
    <div class="agent-chat-window__frame">
        <section class="agent-chat-window__top">
            <h3 class="agent-chat-window__title">
                <span class="agent-chat-window__title-icon" aria-hidden="true">⚡</span>
                <span>Agent AI</span>
            </h3>

            <div class="agent-chat-window__actions">
                <div class="agent-chat-window__panel-left">

                    <select class="agent-chat-window__conversation-list"
                            aria-label="Wybierz konwersację"
                            title="Wybierz konwersację"
                            value="@(ViewModel?.ActiveChat?.Id.ToString() ?? string.Empty)"
                            @onchange="UserInput_SelectConversation">
                        @foreach (var conversation in ViewModel?.Conversations ?? [])
                        {
                            <option value="@conversation.Id" @key="conversation.Id">@conversation.Title</option>
                        }
                    </select>

                    <button type="button"
                            class="agent-chat-window__rename-button"
                            title="Zmień nazwę konwersacji"
                            aria-label="Zmień nazwę konwersacji"
                            @onclick="() => UserInput_RenameConversation(ViewModel?.ActiveChat)">
                        <span aria-hidden="true">✎</span>
                    </button>
                </div>

                <div class="agent-chat-window__panel-right">
                    <button type="button" aria-label="Nowy wątek" title="Nowy wątek" @onclick="UserInput_NewThread">
                        <span aria-hidden="true">＋</span>
                    </button>

                    <button type="button" aria-label="Skasuj wątek" title="Skasuj wątek" @onclick="UserInput_DeleteThread">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
            </div>
        </section>

        <section class="agent-chat-window__center">
            <h1>_chat_</h1>
        </section>

        <section class="agent-chat-window__bottom">
            <ChatAgentWindowContext ViewModel="ViewModel.Context"></ChatAgentWindowContext>
            <textarea class="agent-chat-window__message-input"
                      rows="1"
                      placeholder="Type here..."
                      @ref="MessageInputElement"
                      value="@MessageDraft"
                      @oninput="UserInput_MessageDraftChanged"></textarea>
            <ChatAgentWindowMessageOptions ViewModel="ViewModel.MessageOptions"></ChatAgentWindowMessageOptions>
        </section>
    </div>
</div>
