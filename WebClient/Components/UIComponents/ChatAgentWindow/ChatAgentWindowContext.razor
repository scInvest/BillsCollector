<div class="agent-chat-window-context">
    <div class="agent-chat-window-context__toolbar">
        <label class="agent-chat-window-context__field">
            <select aria-label="Tryb zarządzania kontekstem"
                    title="Tryb zarządzania kontekstem"
                    @bind="ViewModel.SelectedContextMode">
                @foreach (var mode in ViewModel.ContextModes)
                {
                    <option value="@mode.Value" title="@mode.Text">@mode.Text</option>
                }
            </select>
        </label>

        <button type="button"
                class="agent-chat-window-context__add-button"
                aria-label="Dodaj kontekst"
                title="Dodaj kontekst"
                @onclick="UserInput_AddContext">
            <span aria-hidden="true">+</span>
        </button>
    </div>

    <div class="agent-chat-window-context__list" aria-label="Lista kontekstów">
        @foreach (var context in ViewModel.Contexts)
        {
            <div class="agent-chat-window-context__item" @key="context.Id">
                <span class="agent-chat-window-context__file-icon" aria-hidden="true">📄</span>
                <span class="agent-chat-window-context__title" title="@context.Title">@context.Title</span>

                <button type="button"
                        class="agent-chat-window-context__remove-button"
                        aria-label="Usuń kontekst @context.Title"
                        title="Usuń kontekst @context.Title"
                        @onclick="() => UserInput_RemoveContext(context)">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
        }
    </div>
</div>
