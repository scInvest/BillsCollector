<div class="agent-chat-window-message-options">
    <label class="agent-chat-window-message-options__field">
        <select @bind="ViewModel.SelectedMode">
            @foreach (var mode in ViewModel.Modes)
            {
                <option value="@mode.Value" title="@mode.Tooltip">@mode.Value</option>
            }
        </select>
    </label>

    <label class="agent-chat-window-message-options__field">
        <select @bind="ViewModel.SelectedModel">
            @foreach (var model in ViewModel.Models)
            {
                <option value="@model">@model</option>
            }
        </select>
    </label>

    <button type="button"
            class="agent-chat-window-message-options__api-key-button @ViewModel.ApiKeyButtonClass"
            aria-label="Klucz API"
            title="Nie stac mnie na sponsorowanie tysiaca agentów AI, dodaj swoj klucz please :)">
        <span class="agent-chat-window-message-options__api-key-icon" aria-hidden="true">🔑</span>
        <span>klucz API</span>
    </button>

    <button type="button"
            class="agent-chat-window-message-options__send-button @ViewModel.SendButtonClass"
            style="margin-left:-3px;"
            @onclick="ViewModel.UserInput_SendOrCancelChatAgentMessage"
            aria-label="@ViewModel.SendButtonTooltip"
            title="@ViewModel.SendButtonTooltip">
        <span class="agent-chat-window-message-options__send-icon" aria-hidden="true"></span>
    </button>
</div>
