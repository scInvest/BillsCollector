<div class="agent-chat-window-message-options">
    <label class="agent-chat-window-message-options__field">
        <select @bind="ViewModel.SelectedMode">
            @foreach (var mode in ViewModel.Modes)
            {
                <option value="@mode.Value" title="@mode.Tooltip">@mode.Value</option>
            }
        </select>
    </label>

    <label class="agent-chat-window-message-options__field">
        <select @bind="ViewModel.SelectedModel">
            @foreach (var model in ViewModel.Models)
            {
                <option value="@model">@model</option>
            }
        </select>
    </label>

    <button type="button"
            class="agent-chat-window-message-options__send-button @ViewModel.SendButtonClass"
            @onclick="ViewModel.UserInput_Send"
            aria-label="Wyślij">
        <span class="agent-chat-window-message-options__send-icon" aria-hidden="true"></span>
    </button>
</div>
