@using WebClient.Components.UIComponents.ChatProgressStatus

<section class="conversation-preview">
    <div class="conversation-preview__history" role="log" aria-label="Historia konwersjacji">
        @foreach (var message in ViewModel.Messages)
        {
            <article class="conversation-preview__message @GetMessageCssClass(message)"
                     title="@GetMessageTooltip(message)">
                <div class="conversation-preview__bubble">
                    <div class="conversation-preview__content">@message.Content</div>
                </div>
            </article>
        }
    </div>

    <ChatProgressStatus ViewModel="ViewModel.ProgressStatus"></ChatProgressStatus>
</section>
